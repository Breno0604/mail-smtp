# Run lint-staged on staged files
npx lint-staged

# Arquivos que exigem cache bump (JS, CSS, HTML, assets estáticos)
# Ignora testes, dist, node_modules, arquivos de config
STATIC_FILES=$(git diff --cached --name-only | grep -E '\.(js|css|html|json|png|ico|svg|woff2?)$' | grep -v '^tests/' | grep -v '^dist/' | grep -v '^node_modules/' | grep -v '^\.husky/' || true)

if [ -n "$STATIC_FILES" ]; then
  # Lê versão atual do CACHE_NAME
  CURRENT=$(grep -oE "retorno-v[0-9]+" sw.js | sed 's/retorno-v//')
  
  if [ -n "$CURRENT" ]; then
    NEXT=$((CURRENT + 1))
    
    # Atualiza sw.js
    sed -i "s/retorno-v${CURRENT}/retorno-v${NEXT}/" sw.js
    
    # Re-adiciona ao commit
    git add sw.js
    
    echo "🔄 CACHE_NAME bumpado: v${CURRENT} → v${NEXT} (arquivos: $(echo $STATIC_FILES | tr '\n' ' '))"
  fi
fi