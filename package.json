{
  "name": "mail-mvp",
  "version": "1.1.0",
  "description": "Minimal webmail with SMTP and attachments",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i tailwind-input.css -o tailwind.css --minify",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky install"
  },
  "dependencies": {
    "nodemailer": "^6.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@eslint/js": "^9.21.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.4.3",
    "postcss": "^8.5.15",
    "prettier": "^3.5.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "vitest": "^4.1.8"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,html,md}": [
      "prettier --write"
    ]
  }
}
