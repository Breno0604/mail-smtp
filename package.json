{
  "name": "mail-mvp",
  "version": "1.1.0",
  "description": "Minimal webmail with SMTP and attachments",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "build:css": "tailwindcss -i tailwind-input.css -o tailwind.css --minify"
  },
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "dexie": "^4.4.3",
    "nodemailer": "^6.9.0",
    "pinia": "^3.0.4",
    "uuid": "^14.0.0",
    "vue": "^3.5.38",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.2.8",
    "@pinia/testing": "^1.0.3",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^20.19.43",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.11",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.6",
    "vue-tsc": "^2.2.12"
  }
}
